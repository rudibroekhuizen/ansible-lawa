# App
LAWA_FQDN={{ lawa_fqdn }}
WEBDAV_ENDPOINT_URL={{ webdav_endpoint_url }}
WEBDAV_USER={{ webdav_user }}
WEBDAV_PASSWORD={{ webdav_password }}

# ClickHouse
CLICKHOUSE_VERSION=24.8
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DB=lawa
CLICKHOUSE_USER={{ clickhouse_user }}
CLICKHOUSE_PASSWORD={{ clickhouse_password }}

# Postgres
POSTGRES_HOST=postgres
POSTGRES_DB=lawa
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_CONFD={{ postgres_confd }}
POSTGRES_PORT=5432

# Traefik
TRANSIP_ACCOUNT_NAME={{ transip_account_name }}

# Oauth
PROVIDERS_GOOGLE_CLIENT_ID={{ providers_google_client_id }}
PROVIDERS_GOOGLE_CLIENT_SECRET={{ providers_google_client_secret }}
SECRET={{ secret }}
AUTH_HOST={{ auth_host }}
COOKIE_DOMAIN={{ cookie_domain }}
WHITELIST={{ whitelist }}
OAUTH_FQDN={{ oauth_fqdn }}

